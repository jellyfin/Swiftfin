    }, {
      "name": "Swiftfin tvOS",
      "id": "5358705F2669D21600D05A09",
      "product": "id:535870602669D21600D05A09",
      "product-type": "application",
      "specialized-configurations": [
        { "name": "Debug", "file": { "anchor": "XcodeConfig", "relative-path": "Shared.xcconfig" } },
        { "name": "Release", "file": { "anchor": "XcodeConfig", "relative-path": "Shared.xcconfig" } },
      ],
      "build-phases": [
        {
          "kind": "script",
          "name": "Generate Strings",
          "log-environment-variables": true,
          "input-paths": [
            "$(SRCROOT)/Translations/en.lproj/Localizable.strings",
            "$(SRCROOT)/Scripts/Translations/GenerateStrings.swift",
          ],
          "run-on-every-build": true,
          "shell": "/bin/sh",
          "script": [
            "set -eu",
            "cd \"${SRCROOT}\"",
            "xcrun --sdk macosx swift \"${SRCROOT}/Scripts/Translations/GenerateStrings.swift\"",
            "",
          ],
        }, {
          "kind": "script",
          "name": "Run SwiftFormat",
          "log-environment-variables": true,
          "run-on-every-build": true,
          "shell": "/bin/sh",
          "script": [
            "# Add Homebrew to the path to support Apple Silicon Homebrew SwiftFormat installations",
            "export PATH=/opt/homebrew/bin:$PATH",
            "",
            "# Skip phase if the action is not build (ie. analyze, archive, etc).",
            "if [ \"$ACTION\" != \"build\" ]; then",
            "    exit 0",
            "fi",
            "",
            "if which swiftformat >/dev/null; then",
            "    swiftformat .",
            "else",
            "    echo \"error: SwiftFormat not installed, check contributing.md for installation instructions.\"",
            "fi",
            "",
          ],
        }, {
          "kind": "script",
          "name": "Run SwiftLint",
          "log-environment-variables": true,
          "run-on-every-build": true,
          "shell": "/bin/sh",
          "script": [
            "export PATH=\"/opt/homebrew/bin:/usr/local/bin:$PATH\"",
            "",
            "if command -v swiftlint >/dev/null; then",
            "  swiftlint lint",
            "else",
            "  echo \"warning: SwiftLint not installed. Run 'brew bundle --file Brewfile' from the repository root.\"",
            "fi",
            "",
          ],
        },
        "compile-sources",
        "frameworks",
        "resources",
        {
          "kind": "script",
          "name": "Write Git Branch",
          "log-environment-variables": true,
          "input-paths": [
            "$(SRCROOT)/Scripts/WriteGitBranch.sh",
          ],
          "output-paths": [
            "$(TARGET_BUILD_DIR)/$(UNLOCALIZED_RESOURCES_FOLDER_PATH)/GitBranch.txt",
          ],
          "run-on-every-build": true,
          "shell": "/bin/sh",
          "script": "/bin/sh \"${SRCROOT}/Scripts/WriteGitBranch.sh\"\n",
        },
      ],
